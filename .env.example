# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# DATABASE_URL: PostgreSQL connection string (for Prisma production deployment)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stitchora_db?schema=public"

# RAZORPAY CONFIGURATION: Indian Payment Gateway (Test and Production keys)
# Generate from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_StitchoraDemoKey"
RAZORPAY_KEY_SECRET="stitchora_test_secret_key"

# JWT / SESSION SECRET
SESSION_SECRET="stitchora_couture_jwt_secret_key_2026"

# CLOUDINARY (Optional for external image storage)
CLOUDINARY_CLOUD_NAME="stitchora"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SUPABASE BACKEND CONFIGURATION
# Supabase Project ID: ogiiheusnnyzqzltontv
SUPABASE_PROJECT_ID="ogiiheusnnyzqzltontv"
SUPABASE_URL="https://ogiiheusnnyzqzltontv.supabase.co"
# Get your project anon public or service_role key from:
# https://supabase.com/dashboard/project/ogiiheusnnyzqzltontv/settings/api
SUPABASE_ANON_KEY="your_supabase_anon_or_service_role_key"

